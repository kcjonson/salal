#version 330 core

// Base shader - unified fragment shader for shapes and text
// (Ground tiles render in a dedicated pass: tile.vert/tile.frag)
//
// Output is premultiplied alpha in every mode, blended (ONE, ONE_MINUS_SRC_ALPHA).
// Batched colours arrive premultiplied; the instanced and baked paths' arrive
// straight. An additive draw writes alpha 0, which makes the same blend state add
// its colour and leave the destination alpha alone.

in vec2			v_local;
in vec2			v_texCoord;
in vec4			v_fill;
flat in vec2	v_halfSize;
flat in vec4	v_radii;
flat in vec4	v_border;
flat in vec4	v_shape; // per mode, as base.vert has it
flat in vec4	v_clip;	 // (minX, minY, maxX, maxY), or zero for none
flat in uvec3	v_mode;	 // (mode, flags, texture slot or a rect's fill hook)
flat in uvec3	v_fillParams;

out vec4 FragColor;

// The draw's textures, one a unit, an instance's slot picking one: MSDF font atlases
// for text, images for image quads (ignored by every other mode)
uniform sampler2D u_textures[8];

// u_bakedAlpha (instanced and baked draws), and u_viewportHeight and u_pixelRatio
// (the clip test's y flip: OpenGL's origin is bottom-left, the UI's top-left), then the
// consumer's fill hooks and applyFillHook, which picks one (generated by the build,
// docs/shader-hooks.md)
#include "includes/uniforms.glsl"
#include "hooks.glsl"

// Modes and flags, as BatchRenderer.h has them; instanced is base.vert's own
const uint kModeFlat = 0u;
const uint kModeRect = 1u;
const uint kModeShadow = 2u;
const uint kModeArc = 3u;
const uint kModeImage = 4u;
const uint kModeInstanced = 7u;
const uint kFlagAdditive = 1u;
const uint kFlagBorderShift = 1u; // two bits: the border inside, centred or outside
const uint kFlagBareShift = 3u;	  // four bits: a rect's sides with no border, top, right, bottom, left

const float kPi = 3.14159265;

// SDF for a rounded rectangle, Inigo Quilez's, each quadrant with its own corner's
// radius, (top-left, top-right, bottom-right, bottom-left) with y down. A radius
// larger than the shape is clamped to its half size, a capsule.
float sdRoundedBox(vec2 p, vec2 size, vec4 radii) {
	float radius = p.x < 0.0 ? (p.y < 0.0 ? radii.x : radii.w) : (p.y < 0.0 ? radii.y : radii.z);
	radius = min(radius, min(size.x, size.y));
	vec2 q = abs(p) - size + radius;
	return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
}

// How far round a rounded box's outline (half size `size`, corner radii (tl, tr, br, bl)) the
// point nearest p lies, clockwise on screen from the middle of the top-left corner: the runs
// and quarter arcs in turn, each arc's length its radius times the angle into it.
// BatchRenderer's rectOutlineLength is the whole loop.
float outlineLength(vec2 p, vec2 size, vec4 radii) {
	vec4  r = min(radii, vec4(min(size.x, size.y)));
	float quarter = 0.5 * kPi;
	float topStart = 0.5 * quarter * r.x;
	float topRight = topStart + 2.0 * size.x - r.x - r.y;
	float right = topRight + quarter * r.y;
	float bottomRight = right + 2.0 * size.y - r.y - r.z;
	float bottom = bottomRight + quarter * r.z;
	float bottomLeft = bottom + 2.0 * size.x - r.z - r.w;
	float left = bottomLeft + quarter * r.w;
	float topLeft = left + 2.0 * size.y - r.w - r.x;

	bool  east = p.x >= 0.0;
	bool  south = p.y >= 0.0;
	float radius = east ? (south ? r.z : r.y) : (south ? r.w : r.x);
	vec2  d = p - vec2(east ? size.x - radius : radius - size.x, south ? size.y - radius : radius - size.y);
	if ((east ? d.x > 0.0 : d.x < 0.0) && (south ? d.y > 0.0 : d.y < 0.0)) {
		if (east) {
			return south ? bottomRight + radius * atan(d.y, d.x) : topRight + radius * atan(d.x, -d.y);
		}
		return south ? bottomLeft + radius * atan(-d.x, d.y) : topLeft + radius * atan(-d.y, -d.x);
	}
	vec2 q = abs(p) - size;
	if (q.x > q.y) {
		return east ? right + p.y + size.y - r.y : left + size.y - r.w - p.y;
	}
	return south ? bottom + size.x - r.z - p.x : topStart + p.x + size.x - r.x;
}

// Median of three values (for multi-channel SDF)
float median(float r, float g, float b) {
	return max(min(r, g), min(max(r, g), b));
}

// A sampler array takes only constant indices in GLSL 3.30, hence the switches. The
// sample is in non-uniform control flow, where implicit derivatives are undefined, so
// it reads level 0 (no texture has mips); the derivatives text needs are taken first.
vec4 sampleSlot(uint slot, vec2 uv) {
	switch (slot) {
		case 1u: return textureLod(u_textures[1], uv, 0.0);
		case 2u: return textureLod(u_textures[2], uv, 0.0);
		case 3u: return textureLod(u_textures[3], uv, 0.0);
		case 4u: return textureLod(u_textures[4], uv, 0.0);
		case 5u: return textureLod(u_textures[5], uv, 0.0);
		case 6u: return textureLod(u_textures[6], uv, 0.0);
		case 7u: return textureLod(u_textures[7], uv, 0.0);
		default: return textureLod(u_textures[0], uv, 0.0);
	}
}

vec2 slotSize(uint slot) {
	switch (slot) {
		case 1u: return vec2(textureSize(u_textures[1], 0));
		case 2u: return vec2(textureSize(u_textures[2], 0));
		case 3u: return vec2(textureSize(u_textures[3], 0));
		case 4u: return vec2(textureSize(u_textures[4], 0));
		case 5u: return vec2(textureSize(u_textures[5], 0));
		case 6u: return vec2(textureSize(u_textures[6], 0));
		case 7u: return vec2(textureSize(u_textures[7], 0));
		default: return vec2(textureSize(u_textures[0], 0));
	}
}

// The distance field's range in screen pixels, from the UV's change per pixel
// (fwidth of v_texCoord), over an atlas `atlasSize` texels across
float screenPxRange(float pixelRange, vec2 atlasSize, vec2 texCoordWidth) {
	vec2 unitRange = vec2(pixelRange) / atlasSize;
	vec2 screenTexSize = vec2(1.0) / texCoordWidth;
	return max(0.5 * dot(unitRange, screenTexSize), 1.0);
}

// How much of the pixel lies where dist <= edge, ramped over a pixel either side.
float coverage(float edge, float dist, float pixelSize) {
	return 1.0 - smoothstep(edge - pixelSize, edge + pixelSize, dist);
}

// A premultiplied colour, its alpha 0 when additive.
vec4 blended(vec4 color, bool additive) {
	return vec4(color.rgb, additive ? 0.0 : color.a);
}

void main() {
	// Every derivative is taken here, in uniform control flow, before any branch or
	// discard: inside the mode branches they would be undefined. The rounded box is
	// the rect's and the shadow's distance; the other modes ignore it.
	vec2  texCoordDx = dFdx(v_texCoord);
	vec2  texCoordDy = dFdy(v_texCoord);
	vec2  localDx = dFdx(v_local);
	vec2  localDy = dFdy(v_local);
	float boxDist = sdRoundedBox(v_local, v_halfSize, v_radii);
	float boxPixel = length(vec2(dFdx(boxDist), dFdy(boxDist)));
	// One pixel in local units, from the coordinates themselves: an arc's folds leave its
	// distance's own derivatives unreliable, and a fill hook can take none of its own.
	float pixelSize = sqrt(0.5 * (dot(localDx, localDx) + dot(localDy, localDy)));

	uint mode = v_mode.x;
	bool additive = (v_mode.y & kFlagAdditive) != 0u;

	if (mode == kModeInstanced) {
		float alpha = v_fill.a * u_bakedAlpha;
		FragColor = vec4(v_fill.rgb * alpha, alpha);
		return;
	}

	// The clip, in logical pixels with a top-left origin, tested in physical pixels,
	// half-open: a pixel centre on the right or bottom edge is outside, so a clip w
	// pixels wide keeps w columns. A clip with no width is none.
	if (v_clip.z > v_clip.x) {
		vec4  physicalClip = v_clip * u_pixelRatio;
		float physicalY = u_viewportHeight - gl_FragCoord.y;
		if (gl_FragCoord.x < physicalClip.x || gl_FragCoord.x >= physicalClip.z || physicalY < physicalClip.y ||
			physicalY >= physicalClip.w) {
			discard;
		}
	}

	if (mode == kModeFlat) {
		// Triangles, lines, feather rings: the colour interpolated across the corners
		FragColor = blended(v_fill, additive);

	} else if (mode == kModeRect) {
		// The fill covers boxDist <= 0 and the border its band, each pixel by coverage.
		// A stroke piece is a rect with no border.
		uint  borderPos = (v_mode.y >> kFlagBorderShift) & 3u;
		float borderWidth = v_shape.x;
		float borderInner;
		float borderOuter;
		if (borderPos == 0u) {
			borderOuter = 0.0;
			borderInner = -borderWidth;
		} else if (borderPos == 1u) {
			borderOuter = borderWidth * 0.5;
			borderInner = -borderWidth * 0.5;
		} else {
			borderOuter = borderWidth;
			borderInner = 0.0;
		}

		// A zero-size box with no border covers its whole quad: left to smoothstep,
		// it would ask for smoothstep(0, 0, 0), which GLSL leaves undefined.
		float fillCover = 1.0;
		float bandCover = 0.0;	  // between the border's inner and outer edges
		float bandOverFill = 0.0; // the part of the band inside the shape's edge
		if (v_halfSize.x > 0.0 || v_halfSize.y > 0.0 || borderWidth > 0.001) {
			fillCover = coverage(0.0, boxDist, boxPixel);
		}
		if (borderWidth > 0.001) {
			uint bare = (v_mode.y >> kFlagBareShift) & 15u;
			if (bare == 0u) {
				float innerCover = coverage(borderInner, boxDist, boxPixel);
				bandCover = coverage(borderOuter, boxDist, boxPixel) - innerCover;
				bandOverFill = fillCover - innerCover;
			} else {
				// Sides with no border: the band lies between two boxes, the outer one past a
				// bordered side by borderOuter and on a bare side's edge, the hole in from a
				// bordered side by borderInner and clear past a bare one, so a bordered side runs
				// straight on to a bare one's edge and stops square there. Only a corner between
				// two bordered sides rounds; the batch squared the rest.
				vec4  on = vec4(equal(uvec4(bare) & uvec4(1u, 2u, 4u, 8u), uvec4(0u))); // top, right, bottom, left
				vec4  rounded = on.xxzz * on.wyyw;									   // tl, tr, br, bl
				vec4  outerReach = on * borderOuter;
				vec4  holeReach = on * borderInner + (1.0 - on) * (2.0 * boxPixel);
				vec2  outerLow = -v_halfSize - outerReach.wx;
				vec2  outerHigh = v_halfSize + outerReach.yz;
				vec2  holeLow = -v_halfSize - holeReach.wx;
				vec2  holeHigh = v_halfSize + holeReach.yz;
				float outerDist = sdRoundedBox(v_local - (outerLow + outerHigh) * 0.5, (outerHigh - outerLow) * 0.5, v_radii + rounded * borderOuter);
				float holeDist = sdRoundedBox(v_local - (holeLow + holeHigh) * 0.5, (holeHigh - holeLow) * 0.5, rounded * max(v_radii + borderInner, 0.0));
				bandCover = coverage(0.0, outerDist, boxPixel) - coverage(0.0, max(outerDist, holeDist), boxPixel);
				bandOverFill = fillCover - coverage(0.0, max(boxDist, holeDist), boxPixel);
			}
		}

		// A dash pattern, when there's a gap: a border's measured round its centre line, a
		// stroke's along its piece's axis, v_shape.w where the pattern stands at length 0.
		// Each dash is a box across the line, or with round caps (a negative gap) a capsule
		// half the line's width past its ends.
		if (v_shape.z != 0.0) {
			float along;
			float across;
			float halfWidth;
			if (borderWidth > 0.001) {
				float centre = (borderInner + borderOuter) * 0.5;
				along = outlineLength(v_local, v_halfSize + centre, max(v_radii + centre, 0.0));
				across = boxDist - centre;
				halfWidth = borderWidth * 0.5;
			} else {
				along = v_local.x;
				across = v_local.y;
				halfWidth = v_halfSize.y;
			}
			float dash = v_shape.y;
			float gap = abs(v_shape.z);
			float u = mod(along + v_shape.w, dash + gap);
			float outside = u < dash ? -min(u, dash - u) : min(u - dash, dash + gap - u);
			float dashCover = coverage(0.0, v_shape.z < 0.0 ? length(vec2(max(outside, 0.0), across)) - halfWidth : outside, boxPixel);
			if (borderWidth > 0.001) {
				bandCover = min(bandCover, dashCover);
				bandOverFill = min(bandOverFill, dashCover);
			} else {
				fillCover = min(fillCover, dashCover);
			}
		}
		if (fillCover + bandCover < 0.001) {
			discard;
		}

		// The fill, or what the fill hook the rect names gives in its place, under the border
		// where the band lies inside the shape and beside it outside. The coverages share
		// their edge ramps, so where the fill and an outside border abut they add up to the
		// pixel exactly.
		vec4 fill = applyFillHook(v_mode.z, v_fill, v_local, v_halfSize, v_fillParams, pixelSize);
		vec4 color = fill * (fillCover - v_border.a * bandOverFill) + v_border * bandCover;
		FragColor = blended(color, additive);

	} else if (mode == kModeShadow) {
		// Box-shadow or glow: an approximation of CSS's Gaussian blur, the falloff centred
		// on the shape's edge (half alpha there), full `blur` px inside, zero `blur` outside.
		float blur = max(v_shape.z, 0.5);
		float a = 1.0 - smoothstep(-blur, blur, boxDist);
		if (a < 0.001) {
			discard;
		}
		FragColor = blended(v_fill * a, additive);

	} else if (mode == kModeArc) {
		// Ring, arc or pie: v_radii is (inner, outer, halfSweep). Folded across the x
		// axis, the arc is every angle up to halfSweep; its ends are straight radial cuts.
		vec2  p = vec2(v_local.x, abs(v_local.y));
		float r = length(p);
		// Outside the outer radius, or inside the inner one when there is a hole: a pie's
		// centre is not an edge.
		float dist = r - v_radii.y;
		if (v_radii.x > 0.0) {
			dist = max(dist, v_radii.x - r);
		}
		if (v_radii.z < kPi - 0.0001) {
			vec2 end = vec2(cos(v_radii.z), sin(v_radii.z));
			// Past the end ray is positive. Behind the centre the nearest point of the
			// ray is the centre itself.
			float side = end.x * p.y - end.y * p.x;
			dist = max(dist, dot(p, end) > 0.0 ? side : sign(side) * r);
		}
		float a = 1.0 - smoothstep(-pixelSize, pixelSize, dist);
		if (a < 0.001) {
			discard;
		}
		FragColor = blended(v_fill * a, additive);

	} else if (mode == kModeImage) {
		// Texels are premultiplied, so the premultiplied tint multiplies straight in.
		FragColor = blended(sampleSlot(v_mode.z, v_texCoord) * v_fill, additive);

	} else {
		// MSDF text: the median of the three channels is the signed distance, v_shape.z
		// the atlas's distance range in texels. A shadow grows the outline by its spread,
		// v_shape.x px, and ramps over its blur, v_shape.y, either side, both scaled down
		// to end where the field does, half its range on screen; a glyph's own ramp is
		// half a pixel either side, which always fits.
		vec3  msd = sampleSlot(v_mode.z, v_texCoord).rgb;
		float sd = median(msd.r, msd.g, msd.b);
		float pxRange = screenPxRange(v_shape.z, slotSize(v_mode.z), abs(texCoordDx) + abs(texCoordDy));
		float soft = max(v_shape.y, 0.5);
		float fit = min(1.0, 0.5 * pxRange / (v_shape.x + soft));
		float opacity = smoothstep(-soft * fit, soft * fit, pxRange * (sd - 0.5) + v_shape.x * fit);
		FragColor = blended(v_fill * opacity, additive);
	}
}

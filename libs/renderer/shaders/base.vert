#version 330 core

// Base shader - unified vertex shader for shapes, text, and instanced entities
//
// Three rendering modes (controlled by u_instanced uniform):
//   0 = Batched path: one instance a quad, its six vertices from gl_VertexID
//   1 = GPU instancing path: local mesh positions + per-instance transforms
//   2 = Baked world-space path: pre-transformed world positions → screen space

// Per vertex, for the instanced and baked paths
layout(location = 0) in vec2 a_position; // local mesh position, or world position when baked
layout(location = 2) in vec4 a_color;	 // vertex colour, straight alpha

// Per instance, for the batched path: a BatchInstance (backend/Backend.h), what each
// field holds set by its mode (BatchRenderer.h has the table)
layout(location = 1) in vec4 a_corners01; // top-left xy, top-right xy, screen space
layout(location = 3) in vec4 a_corners23; // bottom-right xy, bottom-left xy
layout(location = 4) in vec4 a_geometry;
layout(location = 5) in vec4 a_clip;	  // (minX, minY, maxX, maxY), or zero for none
layout(location = 8) in uvec2 a_radii;	  // four halves, or a stroke's centre as floats
layout(location = 9) in uvec4 a_fills;	  // rgba8 at each corner, premultiplied
layout(location = 10) in uint a_border;	  // rgba8 premultiplied, or a stroke's corner radius as a float
layout(location = 11) in uvec2 a_shape;	  // four halves, or a stroke's half size as floats
layout(location = 12) in uvec4 a_mode;	  // mode, texture slot (a rect's fill hook), flags, rounded-clip entry

// The per-draw uniform block, then the consumer's vertex hooks and the chain that calls them
// (generated by the build, docs/shader-hooks.md), then instancing support (attributes
// 6-7, helper functions), which runs the chain
#include "includes/uniforms.glsl"
#include "hooks.glsl"
#include "includes/instancing.glsl"

out vec2		 v_local;	 // rect, shadow and stroke: from the box's centre; arc: turned so its middle is +x
out vec2		 v_texCoord; // image and text
out vec4		 v_fill;	 // premultiplied, but straight for the instanced and baked paths
flat out vec2	 v_halfSize; // rect, shadow and stroke
flat out vec4	 v_radii;	 // rect, shadow and stroke: corner radii (tl, tr, br, bl); arc: (inner, outer, halfSweep, 0)
flat out vec4	 v_border;	 // premultiplied
flat out vec4	 v_shape;	 // (border width, reach, blur or range, opacity)
flat out vec4	 v_clip;
flat out uvec3	 v_mode;	   // (mode, flags, texture slot or a rect's fill hook)
flat out uvec3	 v_fillParams; // a hooked rect's params, its fill's corners 1 to 3

// Modes, as BatchRenderer.h has them; instanced is the instanced and baked paths'
const uint kModeFlat = 0u;
const uint kModeRect = 1u;
const uint kModeArc = 3u;
const uint kModeImage = 4u;
const uint kModeText = 5u;
const uint kModeStroke = 6u;
const uint kModeInstanced = 7u;

// The two triangles over the corners top-left, top-right, bottom-right, bottom-left
const int kQuadCorners[6] = int[6](0, 1, 2, 0, 2, 3);

// A half float's value, from the low 16 bits of `bits` (GLSL 3.30 has no unpackHalf2x16)
float halfToFloat(uint bits) {
	uint  exponent = (bits >> 10u) & 31u;
	float mantissa = float(bits & 1023u);
	float magnitude = exponent == 0u ? mantissa * exp2(-24.0) : (1.0 + mantissa / 1024.0) * exp2(float(exponent) - 15.0);
	return (bits & 32768u) != 0u ? -magnitude : magnitude;
}

// The two halves of a word, the low one first, as glm::packHalf2x16 packs them
vec2 halves(uint word) {
	return vec2(halfToFloat(word & 65535u), halfToFloat(word >> 16u));
}

// An rgba8 word, red in the low byte, as glm::packUnorm4x8 packs it
vec4 rgba8(uint word) {
	return vec4(float(word & 255u), float((word >> 8u) & 255u), float((word >> 16u) & 255u), float(word >> 24u)) / 255.0;
}

void main() {
	v_local = vec2(0.0);
	v_texCoord = vec2(0.0);
	v_halfSize = vec2(0.0);
	v_radii = vec4(0.0);
	v_border = vec4(0.0);
	v_shape = vec4(0.0);
	v_clip = vec4(0.0); // no clipping for world entities
	v_fillParams = uvec3(0u);

	if (u_instanced == 1) {
		// Local mesh space through the instance's world position, rotation and scale
		gl_Position = u_projection * u_transform * vec4(instanceToScreen(a_position), 0.0, 1.0);
		v_fill = a_color * getInstanceColorTint();
		v_mode = uvec3(kModeInstanced, 0u, 0u);
		return;
	}
	if (u_instanced == 2) {
		// Already in world space and tinted on the CPU
		gl_Position = u_projection * u_transform * vec4(worldToScreen(a_position), 0.0, 1.0);
		v_fill = a_color;
		v_mode = uvec3(kModeInstanced, 0u, 0u);
		return;
	}

	int	 corner = kQuadCorners[gl_VertexID];
	vec2 side = vec2(corner == 1 || corner == 2 ? 1.0 : -1.0, corner >= 2 ? 1.0 : -1.0);
	vec2 position = corner == 0 ? a_corners01.xy : (corner == 1 ? a_corners01.zw : (corner == 2 ? a_corners23.xy : a_corners23.zw));
	gl_Position = u_projection * u_transform * vec4(position, 0.0, 1.0);

	uint mode = a_mode.x;
	v_mode = uvec3(mode, a_mode.z, a_mode.y);
	v_fill = rgba8(a_fills[corner]);
	v_clip = a_clip;

	if (mode == kModeStroke) {
		// A convex piece shaded by its box: local is the piece's frame (geometry, its rows)
		// times the offset from its centre, all in screen space, so any affine transform holds
		vec2 offset = position - uintBitsToFloat(a_radii);
		v_local = vec2(dot(a_geometry.xy, offset), dot(a_geometry.zw, offset));
		v_halfSize = uintBitsToFloat(a_shape);
		v_radii = vec4(uintBitsToFloat(a_border));
		v_mode.x = kModeRect;
		return;
	}

	v_border = rgba8(a_border);
	v_radii = vec4(halves(a_radii.x), halves(a_radii.y));
	v_shape = vec4(halves(a_shape.x), halves(a_shape.y));
	if (mode == kModeImage || mode == kModeText) {
		// geometry: the uv rect, top-left corner's then bottom-right's
		v_texCoord = vec2(side.x > 0.0 ? a_geometry.z : a_geometry.x, side.y > 0.0 ? a_geometry.w : a_geometry.y);
	} else if (mode == kModeArc) {
		// geometry: (inner, outer, halfSweep, middle); the quad reaches shape.y past outer.
		// Turning the corners' offsets turns everything between them.
		vec2  offset = side * (a_geometry.y + v_shape.y);
		float c = cos(a_geometry.w);
		float s = sin(a_geometry.w);
		v_local = vec2(c * offset.x + s * offset.y, c * offset.y - s * offset.x);
		v_radii = vec4(a_geometry.xyz, 0.0);
	} else if (mode != kModeFlat) {
		// rect, shadow: geometry is (half size, the quad's half extent)
		v_local = side * a_geometry.zw;
		v_halfSize = a_geometry.xy;
		if (mode == kModeRect && a_mode.y != 0u) {
			// A fill hook's rect: one fill, corner 0's, and the other corners' words are its params
			v_fill = rgba8(a_fills[0]);
			v_fillParams = a_fills.yzw;
		}
	}
}
